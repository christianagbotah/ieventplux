# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# env files: runtime .env is NEVER committed; template is tracked
.env*
!.env.example

# SQLite transient WAL/SHM artifacts (the .db itself is tracked for demo continuity)
db/custom.db-shm
db/custom.db-wal

# Read-tool scratch outputs
tool-results/

# User-uploaded files (session input, not product assets)
/upload/

# ops backups (logical snapshots — never committed)
backups/
