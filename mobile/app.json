{
  "expo": {
    "name": "iEventPlux",
    "slug": "ieventplux",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ieventplux",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fafaf9",
    "splash": {
      "backgroundColor": "#fafaf9"
    },
    "ios": {
      "bundleIdentifier": "com.lightworld.ieventplux",
      "supportsTablet": true
    },
    "android": {
      "package": "com.lightworld.ieventplux"
    },
    "plugins": [
      "expo-camera",
      "expo-secure-store"
    ],
    "extra": {
      "apiBaseUrl": "Set via app config / environment — point to the iEventPlux web deployment"
    }
  }
}
