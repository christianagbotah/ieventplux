{
  "expo": {
    "name": "iEventPlux",
    "slug": "ieventplux",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ieventplux",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fafaf9",
    "splash": {
      "backgroundColor": "#fafaf9"
    },
    "ios": {
      "bundleIdentifier": "com.lightworld.ieventplux",
      "supportsTablet": true
    },
    "android": {
      "package": "com.lightworld.ieventplux",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow iEventPlux to access your camera for QR scanning and meeting camera checks.",
          "microphonePermission": "Allow iEventPlux to access your microphone for voice and meeting device checks.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "Allow iEventPlux to use your microphone when you choose to record a voice message."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://ieventplux.lightworldtech.com"
    }
  }
}
