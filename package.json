{
  "name": "ieventplux",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @ieventplux/db db:migrate",
    "db:seed": "pnpm --filter @ieventplux/db db:seed",
    "db:reset": "pnpm --filter @ieventplux/db db:reset"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "turbo": "2.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "@types/node": "22.19.0"
  }
}
