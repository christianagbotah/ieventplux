# Copy to .env for local overrides. All credentials below are synthetic/empty.
# Seeds and reset require development; production also checks NODE_ENV.
APP_ENV=development
NODE_ENV=development
DATABASE_URL=postgresql://ieventplux:ieventplux_dev@localhost:5432/ieventplux
# Separate disposable PostgreSQL database; name MUST end in _test.
TEST_DATABASE_URL=postgresql://ieventplux:ieventplux_dev@localhost:5432/ieventplux_test
REDIS_URL=redis://localhost:6379
# S3-compatible storage; no local S3 service is provisioned in Stage A.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
MOBILE_URL=ieventplux://
# simulator | sandbox | live. Simulator is forbidden in production.
# Separate slots allow independent rotation even when Hubtel provisions the
# same payment API ID/key for multiple payment APIs. All are server-only.
HUBTEL_MODE=simulator
HUBTEL_CHECKOUT_BASE_URL=https://payproxyapi.hubtel.com
HUBTEL_STATUS_BASE_URL=https://api-txnstatus.hubtel.com
HUBTEL_REFUND_BASE_URL=https://refund-api.hubtel.com
HUBTEL_SEND_MONEY_BASE_URL=https://smp.hubtel.com
HUBTEL_PAYOUT_STATUS_BASE_URL=https://smrsc.hubtel.com
HUBTEL_SMS_BASE_URL=https://sms.hubtel.com
HUBTEL_CHECKOUT_API_ID=
HUBTEL_CHECKOUT_API_KEY=
HUBTEL_STATUS_API_ID=
HUBTEL_STATUS_API_KEY=
HUBTEL_REFUND_API_ID=
HUBTEL_REFUND_API_KEY=
HUBTEL_SEND_MONEY_API_ID=
HUBTEL_SEND_MONEY_API_KEY=
# Collection POS sales ID and merchant account, NOT disbursement accounts.
HUBTEL_POS_SALES_ID=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
# Prepaid/disbursement account for Send Money and payout status APIs.
HUBTEL_DISBURSEMENT_ACCOUNT=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
# Approved sender: at most 11 alphanumeric characters.
HUBTEL_SMS_SENDER=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
# JWK JSON string. Private key is server-only, never shipped to clients.
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=
# Mailpit locally; production must explicitly supply host/port/from.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Optional for unauthenticated relays; use your relay's requirements.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ieventplux.example
# Optional unless Expo push access-token security is enabled.
EXPO_ACCESS_TOKEN=
# AI is optional and disabled when not configured.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
