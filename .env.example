# ─────────────────────────────────────────────────────────────────────────────
# iEventPlux environment configuration (DEVELOPMENT copy — no real secrets here)
# Production checklist: copy to .env and fill real values. See docs/DEPLOYMENT.md.
# Startup validation lives in src/server/env.ts and is surfaced at
# GET /api/v1/health and the admin Integration Health console.
# ─────────────────────────────────────────────────────────────────────────────

# Core (boot-critical in production)
# ── Database provider ─────────────────────────────────────────────────────────
# LIVE DEFAULT since round 26: PostgreSQL 18 (embedded, no root — runs from
#   node_modules/@embedded-postgres via `bun run db:postgres`; scripts/dev-postgres.sh
#   inits/starts the cluster at /home/z/pgdata on 127.0.0.1:5432). The schema
#   provider is postgresql; all three processes (Next.js API, worker, realtime)
#   resolve this URL through src/lib/db.ts, which lets the .env value override
#   the sandbox's exported packaged SQLite default.
# SQLite fallback (rounds ≤ 25): uncomment the file: URL AND flip
#   prisma/schema.prisma provider back to "sqlite", then restart services.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/ieventplux
# DATABASE_URL=file:/home/z/my-project/db/custom.db
# Prisma CLI note: the sandbox shell exports the packaged SQLite URL, which
# beats .env for CLI tools — prefix CLI commands explicitly, e.g.
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5432/ieventplux bunx prisma db push
APP_SECRET=dev-only-insecure-secret-change-me
APP_URL=http://localhost:3000
NODE_ENV=development

# Hubtel — Online Checkout (collections). Docs: https://code.hubtel.com/docs
# Separate credentials per API as required; never expose in client bundles.
HUBTEL_CHECKOUT_BASE=https://pay.hubtel.com
HUBTEL_CHECKOUT_CLIENT_ID=
HUBTEL_CHECKOUT_CLIENT_SECRET=
# Hubtel — Send Money (organizer payouts)
HUBTEL_SENDMONEY_BASE=https://app.hubtel.com
HUBTEL_SENDMONEY_CLIENT_ID=
HUBTEL_SENDMONEY_CLIENT_SECRET=
HUBTEL_SENDMONEY_ACCOUNT_ID=
# Hubtel — SMS. Docs: https://code.hubtel.com/docs/guides/sms-delivery
HUBTEL_SMS_BASE=https://smsc.hubtel.com
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=

# Payment / SMS simulation (explicit, isolated, development-only)
# "auto" = simulate only when the matching real credentials are absent.
# Forcing "1" while NODE_ENV=production is refused by src/server/env.ts.
PAYMENTS_SIMULATOR=auto
SMS_SIMULATOR=auto

# Video provider: "cloudflare-stream" or "simulator"
VIDEO_PROVIDER=simulator
CF_STREAM_API_TOKEN=
CF_STREAM_ACCOUNT_ID=

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ieventplux.local

# Background services
WORKER_PORT=3001
WORKER_SECRET=dev-worker-secret
REALTIME_PORT=3003
REALTIME_SECRET=dev-realtime-secret

# Optional AI (built-in z-ai-web-dev-sdk; no key required in this environment)
AI_CONCIERGE_ENABLED=true
