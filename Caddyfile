# iEventPlux DEVELOPMENT preview gateway (:81).
# Never use this listener in production; see docs/DEPLOYMENT.md for TLS and
# explicit /socket.io/* routing. Restrict XTransformPort to known side services.
:81 {
    @worker {
        query XTransformPort=3001
    }
    @realtime {
        query XTransformPort=3003
    }
    @otherTransform {
        query XTransformPort=*
    }

    handle @worker {
        reverse_proxy 127.0.0.1:3001
    }
    handle @realtime {
        reverse_proxy 127.0.0.1:3003
    }
    handle @otherTransform {
        respond "Unsupported preview target" 403
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
